# ===== Required (both free) =====
# Gemini key: https://aistudio.google.com/apikey  (free tier, no card)
GEMINI_API_KEY=
# Sarvam key: https://dashboard.sarvam.ai  (free starting credits)
SARVAM_API_KEY=

# ===== Models (defaults are fine; change if a model name stops working) =====
LLM_MODEL=gemini-3.5-flash-lite
# If LLM_MODEL is overloaded during a call, the call switches to this model (empty = no fallback)
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
ANALYSIS_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
# minimal | low | medium | high | (empty = model default)
LLM_THINKING_LEVEL=low
# Cancel + retry a live-call LLM request that takes longer than this (free tier can stall). Minimum 10.
LLM_TIMEOUT_SECONDS=10
STT_MODEL=saaras:v4
TTS_MODEL=bulbul:v3
TTS_SPEAKER=priya

# ===== Optional integrations (leave empty -> local CRM / local calendar) =====
# HubSpot free account -> Development -> Legacy apps -> Private app token (contacts + deals scopes)
HUBSPOT_ACCESS_TOKEN=
# Cal.com free account -> Settings -> Developer -> API keys; event type ID from your event type
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
